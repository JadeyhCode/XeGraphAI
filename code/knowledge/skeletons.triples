任务:闰年	关键词	闰年
任务:闰年	骨架	骨架:闰年
任务:闰年	用途	命令行给年份，闰年输出 1，否则 0
骨架:闰年	语言	C11
骨架:闰年	依赖	stdio.h stdlib.h
骨架:闰年	代码	#include <stdio.h>\
#include <stdlib.h>\
static int is_leap(long y) { return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0; }\
int main(int argc, char **argv) {\
    long y = argc > 1 ? atol(argv[1]) : 2024;\
    printf("%d\n", is_leap(y));\
    int ok = is_leap(2024) && !is_leap(1900) && is_leap(2000);\
    printf("%s\n", ok ? "ok leap" : "FAIL leap");\
    return ok ? 0 : 1;\
}
任务:完全平方数	关键词	完全平方数
任务:完全平方数	关键词	平方数
任务:完全平方数	骨架	骨架:完全平方数
任务:完全平方数	用途	命令行给整数，是完全平方数输出 1，否则 0
骨架:完全平方数	语言	C11
骨架:完全平方数	依赖	stdio.h stdlib.h
骨架:完全平方数	代码	#include <stdio.h>\
#include <stdlib.h>\
static int is_square(long n) {\
    if (n < 0) return 0;\
    long lo = 0, hi = 46341;\
    while (lo <= hi) { long mid = lo + (hi - lo) / 2; long sq = mid * mid; if (sq == n) return 1; if (sq < n) lo = mid + 1; else hi = mid - 1; }\
    return 0;\
}\
int main(int argc, char **argv) {\
    long n = argc > 1 ? atol(argv[1]) : 49;\
    printf("%d\n", is_square(n));\
    int ok = is_square(49) && !is_square(50) && is_square(0);\
    printf("%s\n", ok ? "ok square" : "FAIL square");\
    return ok ? 0 : 1;\
}

