#include <string.h>\
static int is_pal(const char *s) {\
    size_t n = strlen(s);\
    for (size_t i = 0; i < n / 2; i++) if (s[i] != s[n-1-i]) return 0;\
    return 1;\
}\
int main(void) {\
    char buf[256] = "";\
    if (fgets(buf, sizeof buf, stdin)) {}\
    size_t l = strlen(buf);\
    while (l && (buf[l-1] == '\n' || buf[l-1] == '\r')) buf[--l] = 0;\
    printf("%d\n", is_pal(buf));\
    int ok = is_pal("racecar") && is_pal("abba") && !is_pal("abc") && is_pal("");\
    printf("%s\n", ok ? "ok pal" : "FAIL pal");\
    return ok ? 0 : 1;\
}
