任务:二分查找	用途	有序数组里找 key，输出下标或 -1
骨架:二分查找	语言	C11
骨架:二分查找	依赖	stdio.h
骨架:二分查找	代码	#include <stdio.h>\
static int bsearch_int(const int *a, int n, int key) {\
    int lo = 0, hi = n - 1;\
    while (lo <= hi) { int mid = lo + (hi - lo) / 2; if (a[mid] == key) return mid; if (a[mid] < key) lo = mid + 1; else hi = mid - 1; }\
    return -1;\
}\
int main(void) {\
    int a[6] = {1,3,5,7,9,11}, n = 6, k;\
    if (scanf("%d", &k) != 1) k = 7;\
    printf("%d\n", bsearch_int(a, n, k));\
    int ok = bsearch_int(a, n, 7) == 3 && bsearch_int(a, n, 4) == -1 && bsearch_int(a, n, 1) == 0;\
    printf("%s\n", ok ? "ok bsearch" : "FAIL bsearch");\
    return ok ? 0 : 1;\
}
