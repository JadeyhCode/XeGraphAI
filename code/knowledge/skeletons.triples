骨架:字符串倒序	依赖	stdio.h string.h
骨架:字符串倒序	代码	#include <stdio.h>\
#include <string.h>\
static void rev(const char *in, char *out) {\
    size_t n = strlen(in);\
    for (size_t i = 0; i < n; i++) out[i] = in[n-1-i];\
    out[n] = 0;\
}\
int main(void) {\
    char buf[256], out[256];\
    if (fgets(buf, sizeof buf, stdin)) {\
        size_t n = strlen(buf);\
        while (n && (buf[n-1] == '\n' || buf[n-1] == '\r')) buf[--n] = 0;\
        rev(buf, out);\
        printf("%s\n", out);\
    }\
    rev("abc", out);\
    int ok = strcmp(out, "cba") == 0;\
    rev("hello world", out);\
    ok = ok && strcmp(out, "dlrow olleh") == 0;\
    printf("%s\n", ok ? "ok rev" : "FAIL rev");\
    return ok ? 0 : 1;\
}
