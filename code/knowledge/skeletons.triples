骨架:最值平均	语言	C11
骨架:最值平均	依赖	stdio.h
骨架:最值平均	代码	#include <stdio.h>\
static void stats(const long *v, int n, long *mx, long *mn, double *avg) {\
    *mx = v[0]; *mn = v[0]; double s = 0;\
    for (int i = 0; i < n; i++) { if (v[i] > *mx) *mx = v[i]; if (v[i] < *mn) *mn = v[i]; s += v[i]; }\
    *avg = n > 0 ? s / n : 0;\
}\
int main(void) {\
    int n = 0;\
    long v[64];\
    if (scanf("%d", &n) != 1 || n <= 0 || n > 64) n = 5;\
    for (int i = 0; i < n; i++) if (scanf("%ld", &v[i]) != 1) v[i] = 0;\
    long mx = 0, mn = 0; double avg = 0;\
    stats(v, n, &mx, &mn, &avg);\
    printf("max=%ld min=%ld avg=%.2f\n", mx, mn, avg);\
    long t[5] = {3,1,4,1,5}, tmx = 0, tmn = 0; double tavg = 0;\
    stats(t, 5, &tmx, &tmn, &tavg);\
    int ok = (tmx == 5 && tmn == 1 && tavg > 2.79 && tavg < 2.81);\
    printf("%s\n", ok ? "ok stats" : "FAIL stats");\
    return ok ? 0 : 1;\
}
