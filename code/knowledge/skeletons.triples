int main(void) {\
    int a[2][2] = {{1,2},{3,4}}, b[2][2] = {{5,6},{7,8}}, c[2][2];\
    for (int i = 0; i < 2; i++)\
        for (int j = 0; j < 2; j++) {\
            c[i][j] = 0;\
            for (int k = 0; k < 2; k++) c[i][j] += a[i][k] * b[k][j];\
        }\
    for (int i = 0; i < 2; i++) printf("%d %d\n", c[i][0], c[i][1]);\
    int ok = c[0][0] == 19 && c[0][1] == 22 && c[1][0] == 43 && c[1][1] == 50;\
    printf("%s\n", ok ? "ok matmul" : "FAIL matmul");\
    return ok ? 0 : 1;\
}
