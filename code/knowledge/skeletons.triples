static double f2c(double f) { return (f - 32.0) * 5.0 / 9.0; }\
int main(int argc, char **argv) {\
    double f = argc > 1 ? atof(argv[1]) : 212.0;\
    printf("%.2f\n", f2c(f));\
    double t = f2c(212.0);\
    int ok = (t > 99.999 && t < 100.001);\
    printf("%s\n", ok ? "ok f2c" : "FAIL f2c");\
    return ok ? 0 : 1;\
}
