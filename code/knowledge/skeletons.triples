骨架:最大公约数	代码	#include <stdio.h>\
static long gcd(long a, long b) { while (b) { long t = a % b; a = b; b = t; } return a < 0 ? -a : a; }\
int main(void) {\
    printf("%ld\n", gcd(48, 18));\
    int ok = gcd(48,18) == 6 && gcd(17,5) == 1 && gcd(0,9) == 9 && gcd(100,75) == 25;\
    printf("%s\n", ok ? "ok gcd" : "FAIL gcd");\
    return ok ? 0 : 1;\
}
