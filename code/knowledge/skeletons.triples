骨架:字符统计	代码	#include <stdio.h>\
int main(void) {\
    const char *s = "Hello 42 world!";\
    int letters = 0, digits = 0, spaces = 0, other = 0;\
    for (const char *p = s; *p; p++) {\
        if ((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')) letters++;\
        else if (*p >= '0' && *p <= '9') digits++;\
        else if (*p == ' ') spaces++;\
        else other++;\
    }\
    printf("letters=%d digits=%d spaces=%d other=%d\n", letters, digits, spaces, other);\
    int ok = letters == 10 && digits == 2 && spaces == 2 && other == 1;\
    printf("%s\n", ok ? "ok chars" : "FAIL chars");\
    return ok ? 0 : 1;\
}
