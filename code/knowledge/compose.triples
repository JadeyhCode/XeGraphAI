文件:proj_main.c	代码	#include <stdio.h>\
#include "proj_add.h"\
int main(void) {\
    long r = proj_add(2, 3);\
    printf("%ld\n", r);\
    printf("%s\n", r == 5 ? "ok" : "FAIL");\
    return r == 5 ? 0 : 1;\
}
文件:proj_add.c	代码	long proj_add(long a, long b) { return a + b; }
文件:proj_add.h	代码	long proj_add(long a, long b);
