# §6.703 组合知识：片段（函数）+ 模板（main 骨架）+ 主体（任务特有的那几行）
# 组合器把三类片段按图上的边拼起来 —— 消融时删掉片段代码，程序就编不过
片段:is_prime	代码	static int is_prime(long n) {\
    if (n < 2) return 0;\
    for (long i = 2; i * i <= n; i++) if (n % i == 0) return 0;\
    return 1;\
}
片段:bubble	代码	static void bubble(int *a, int n) {\
    for (int i = 0; i < n - 1; i++)\
        for (int j = 0; j < n - 1 - i; j++)\
            if (a[j] > a[j+1]) { int t = a[j]; a[j] = a[j+1]; a[j+1] = t; }\
}
模板:命令行整数	代码	#include <stdio.h>\
#include <stdlib.h>\
int main(int argc, char **argv) {\
    long N = argc > 1 ? atol(argv[1]) : 30;\
    int ok = 1;\
<SLOTS>\
    printf("%s\n", ok ? "ok" : "FAIL");\
    return ok ? 0 : 1;\
}
