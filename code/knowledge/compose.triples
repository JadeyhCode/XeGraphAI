模板:标准输入矩阵	代码	#include <stdio.h>\
int main(void) {\
    int rr = 0, cc = 0;\
    if (scanf("%d %d", &rr, &cc) != 2) { rr = 0; cc = 0; }\
    long m[16][16];\
    for (int i = 0; i < rr && i < 16; i++)\
        for (int j = 0; j < cc && j < 16; j++)\
            if (scanf("%ld", &m[i][j]) != 1) m[i][j] = 0;\
    int ok = 1;\
<SLOTS>\
    printf("%s\n", ok ? "ok" : "FAIL");\
    return ok ? 0 : 1;\
}
