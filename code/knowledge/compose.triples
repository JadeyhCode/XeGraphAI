任务:排序取中位数	主体	    int a[7] = {9, 3, 7, 1, 5, 8, 2};\
    int n = 7;\
    bubble(a, n);\
    int mid = a[n / 2];\
    printf("%d\n", mid);\
    if (mid != 5) ok = 0;
片段:count_primes_to	代码	static long count_primes_to(long n) {\
    long c = 0;\
    for (long i = 2; i <= n; i++) if (is_prime(i)) c++;\
    return c;\
}
