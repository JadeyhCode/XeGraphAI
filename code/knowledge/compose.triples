运算:去极值平均	关键词	去掉最大值和最小值
运算:去极值平均	语句	{ long mn = v[0], mx = v[0], sum = 0; for (int i = 0; i < n; i++) { if (v[i] < mn) mn = v[i]; if (v[i] > mx) mx = v[i]; sum += v[i]; } x = (n > 2) ? (sum - mn - mx) * (long)n / (long)(n - 2) : 0; }
