#include <stdlib.h>\
#include <string.h>\
static int cmp_long(const void *a, const void *b) {\
    long x = *(const long *)a, y = *(const long *)b;\
    return (x > y) - (x < y);\
}\
static int cmp_desc(const void *a, const void *b) {\
    long x = *(const long *)a, y = *(const long *)b;\
    return (x < y) - (x > y);\
}\
int main(void) {\
    long v[256]; int n = 0;\
    while (n < 256 && scanf("%ld", &v[n]) == 1) n++;\
    if (n <= 0) return 0;\
    long x = 0; (void)x;\
    { for (int i = 0, j = n - 1; i < j; i++, j--) { long t = v[i]; v[i] = v[j]; v[j] = t; } }\
    { for (int i = 1; i < n; i++) v[i] += v[i - 1]; }\
