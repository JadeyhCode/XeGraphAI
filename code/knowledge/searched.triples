骨架:搜索-极差	代码	#include <stdio.h>\
#include <stdlib.h>\
#include <string.h>\
static int cmp_long(const void *a, const void *b) {\
    long x = *(const long *)a, y = *(const long *)b;\
    return (x > y) - (x < y);\
}\
static int cmp_desc(const void *a, const void *b) {\
    long x = *(const long *)a, y = *(const long *)b;\
    return (x < y) - (x > y);\
}\
int main(void) {\
    long v[256]; int n = 0;\
    while (n < 256 && scanf("%ld", &v[n]) == 1) n++;\
    if (n <= 0) return 0;\
    long x = 0; (void)x;\
    { x = v[0]; { long lo = v[0]; for (int i = 1; i < n; i++) { if (v[i] > x) x = v[i]; if (v[i] < lo) lo = v[i]; } x -= lo; } }\
    printf("%ld\n", x);\
    return 0;\
}
