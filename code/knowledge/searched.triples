#include <stdlib.h>\
#include <string.h>\
static int cmp_long(const void *a, const void *b) {\
    long x = *(const long *)a, y = *(const long *)b;\
    return (x > y) - (x < y);\
}\
static int cmp_desc(const void *a, const void *b) {\
    long x = *(const long *)a, y = *(const long *)b;\
    return (x < y) - (x > y);\
}\
int main(void) {\
    long v[256]; int n = 0;\
    while (n < 256 && scanf("%ld", &v[n]) == 1) n++;\
    if (n <= 0) return 0;\
    long x = 0; (void)x;\
    { x = 0; { long s = 0; for (int i = 0; i < n; i++) s += v[i]; long mu = s / n; for (int i = 0; i < n; i++) { long d = v[i] - mu; x += d * d; } x /= n; } }\
    printf("%ld\n", x);\
    return 0;\
}
