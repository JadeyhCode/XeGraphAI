骨架:搜索-去重	依赖	stdio.h stdlib.h string.h
骨架:搜索-去重	代码	#include <stdio.h>\
#include <stdlib.h>\
#include <string.h>\
static int cmp_long(const void *a, const void *b) {\
    long x = *(const long *)a, y = *(const long *)b;\
    return (x > y) - (x < y);\
}\
static int cmp_desc(const void *a, const void *b) {\
    long x = *(const long *)a, y = *(const long *)b;\
    return (x < y) - (x > y);\
}\
int main(void) {\
    long v[256]; int n = 0;\
    while (n < 256 && scanf("%ld", &v[n]) == 1) n++;\
    if (n <= 0) return 0;\
    long x = 0; (void)x;\
    { { qsort(v, (size_t)n, sizeof v[0], cmp_long); int m = 0; for (int i = 0; i < n; i++) if (i == 0 || v[i] != v[i - 1]) v[m++] = v[i]; n = m; } }\
    for (int i = 0; i < n; i++) printf("%ld%c", v[i], i + 1 == n ? 10 : 32);\
    return 0;\
}
